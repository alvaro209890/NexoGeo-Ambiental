[Unit]
Description=NexoGeo Ambiental Backend (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/acer/Documentos/NexoGeo-Ambiental
ExecStart=/home/acer/Documentos/NexoGeo-Ambiental/.venv/bin/python -m uvicorn api.app:app --host 127.0.0.1 --port 8000 --log-level warning
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
