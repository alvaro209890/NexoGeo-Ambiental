{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexomap.ai/schema/mapspec.schema.json",
  "title": "MapSpec NexoMap AI",
  "type": "object",
  "required": ["titulo", "tipo", "area_base", "layout_template", "escala", "basemap", "camadas", "elementos_layout", "saidas"],
  "additionalProperties": false,
  "properties": {
    "titulo": { "type": "string" },
    "tipo": { "type": "string" },
    "area_base": { "type": "string", "const": "projeto.area_base" },
    "layout_template": { "type": "string" },
    "escala": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
    "basemap": { "type": "string" },
    "camadas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fonte"],
        "properties": {
          "id": { "type": "string" },
          "fonte": { "type": "string" },
          "filtro": { "type": "string" },
          "estilo": { "type": "object" },
          "rotulo": { "type": "boolean" }
        }
      }
    },
    "elementos_layout": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "saidas": {
      "type": "array",
      "items": { "type": "string", "enum": ["mxd", "pdf", "png_validacao"] }
    }
  }
}
